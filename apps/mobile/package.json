{
  "name": "lupira-assistant-mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc -b",
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "gen:api": "orval --config ./orval.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:preview": "eas build --profile preview --platform android",
    "build:android": "eas build --profile production --platform android"
  },
  "dependencies": {
    "@danbro96/lupira-expo-diagnostics": "0.2.1",
    "@danbro96/lupira-expo-feedback": "1.0.0",
    "@danbro96/lupira-expo-oidc": "0.2.0",
    "@danbro96/lupira-expo-paper": "0.5.0",
    "@danbro96/lupira-http": "0.1.0",
    "@danbro96/lupira-tokens-core": "0.2.0",
    "@expo/vector-icons": "^15.1.1",
    "@lupira/assistant-tokens": "*",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.3.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-background-task": "~57.0.20",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@danbro96/lupira-config-eslint": "0.2.0",
    "@danbro96/lupira-config-ts": "0.1.0",
    "@types/react": "19.2.17",
    "eslint-plugin-react-hooks": "^7.1.1",
    "orval": "^8.37.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  }
}
