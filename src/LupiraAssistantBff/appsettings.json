{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Bearer": {
      "Authority": "https://auth.lupira.com/application/o/lupira-assistant/",
      "Audience": "lupira-assistant"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "assistant-api": {
        "Destinations": {
          "primary": {
            "Address": "http://lupira-assistant-api:8080"
          }
        }
      },
      "comms-api": {
        "Destinations": {
          "primary": {
            "Address": "http://lupira-comms-api:8080"
          }
        }
      },
      "location-api": {
        "Destinations": {
          "primary": {
            "Address": "http://lupira-location-api:8080"
          }
        }
      },
      "health-api": {
        "Destinations": {
          "primary": {
            "Address": "http://lupira-health-api:8080"
          }
        }
      }
    }
  }
}
